APP_NAME="CareerSaathi AI API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
CLIENT_URL="http://localhost:5173"

POSTGRES_USER="careersaathi_app"
POSTGRES_PASSWORD="replace_with_your_database_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="careersaathi_ai"

JWT_SECRET_KEY="replace_with_a_secure_random_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME="careersaathi_refresh_token"
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE="lax"
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

EMAIL_DELIVERY_ENABLED=false

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true

EMAIL_FROM_NAME="CareerSaathi AI"
EMAIL_FROM_ADDRESS="no-reply@example.com"
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30